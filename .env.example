# ───── Куда уходит заявка ─────────────────────────────────────────────
# Эндпоинт бэкенда/серверless-функции, принимающей лид (раздел 8.6 ТЗ).
# Пока пусто — форма открывает черновик WhatsApp из прототипа; сообщение отправляет посетитель.
VITE_LEAD_ENDPOINT=

# ───── Мессенджеры (раздел 8.5 ТЗ) ────────────────────────────────────
# Строка «Или напишите:» показывается только для заполненных ссылок.
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_TELEGRAM=
VITE_CONTACT_INSTAGRAM=
VITE_CONTACT_PHONE=

# ───── Аналитика (раздел 9 ТЗ) ────────────────────────────────────────
# Публичный ID контейнера GTM-XXXXXXX. Пусто = контейнер не подключается.
# Контейнер загружается только после согласия посетителя на аналитику.
VITE_GTM_ID=GTM-NRL6QKJ8

# ───── Прочее ─────────────────────────────────────────────────────────
VITE_SITE_URL=https://franchise.itadis.kg
