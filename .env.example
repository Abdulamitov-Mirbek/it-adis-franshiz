# ───── Куда уходит заявка ─────────────────────────────────────────────
# Эндпоинт бэкенда/серверless-функции, принимающей лид (раздел 8.6 ТЗ).
# Пока пусто — форма работает в демо-режиме и ничего не отправляет.
VITE_LEAD_ENDPOINT=

# ───── Мессенджеры (раздел 8.5 ТЗ) ────────────────────────────────────
# Строка «Или напишите:» показывается только для заполненных ссылок.
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_TELEGRAM=
VITE_CONTACT_INSTAGRAM=
VITE_CONTACT_PHONE=

# ───── Аналитика (раздел 9 ТЗ) ────────────────────────────────────────
# Пусто = система не подключается.
VITE_GA4_ID=
VITE_META_PIXEL_ID=
VITE_YANDEX_METRIKA_ID=

# ───── Прочее ─────────────────────────────────────────────────────────
VITE_SITE_URL=https://franchise.itadis.kg
